**/results/*results.json
**/results/raw_results.json
**/results/*samples*.json

# Local/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Credentials and environment files
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
